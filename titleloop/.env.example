# Django environment configuration.
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file — it is gitignored.

# Secret key used for cryptographic signing. Generate one with:
#   python -m django.core.management shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-real-secret-key

# Set to False in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts, e.g. "localhost,127.0.0.1"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
